  "jak_uzyc_w_aplikacji": {
    "react_native": {
      "pobierz_trasy": `
const routes = await fetch('https://twoja-domena.pl/wp-json/pks-api/v1/routes')
  .then(r => r.json());

// Result: Array of route objects with line numbers, names, URLs
`,

      "pobierz_przystanki": `
const stops = await fetch('https://twoja-domena.pl/wp-json/pks-api/v1/stops?search=Gdynia')
  .then(r => r.json());

// Result: Array of stops with GPS coordinates (lat, lon)
`,

      "otworz_rozklad": `
const schedule = await fetch('https://twoja-domena.pl/wp-json/pks-api/v1/schedule/150')
  .then(r => r.json());

// Result: Object with PDF URL - otwórz w przeglądarce lub viewer
Linking.openURL(schedule.pdf_url);
`
    },

    "javascript": {
      "wszystkie_trasy": `
// Pobierz wszystkie 91 tras
fetch('/wp-json/pks-api/v1/routes')
  .then(response => response.json())
  .then(routes => {
    console.log('Tras PKS:', routes.length);
    routes.forEach(route => {
      console.log(route.line + ': ' + route.route);
    });
  });
`,

      "najblizsze_przystanki": `
// Znajdź najbliższe przystanki używając GPS
navigator.geolocation.getCurrentPosition(position => {
  const { latitude, longitude } = position.coords;

  fetch('/wp-json/pks-api/v1/stops')
    .then(response => response.json())
    .then(stops => {
      const sortedStops = stops
        .map(stop => ({
          ...stop,
          distance: calculateDistance(latitude, longitude, stop.lat, stop.lon)
        }))
        .sort((a, b) => a.distance - b.distance)
        .slice(0, 5);

      console.log('Najbliższe przystanki PKS:', sortedStops);
    });
});
`
    }
  },

